# URL de connexion MySQL fournie par ton hébergeur
# Format : mysql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=mysql://user:pass@host:3306/nom_de_la_base

# Mot de passe pour accéder au panel admin
PANEL_PASSWORD=change_ce_mot_de_passe

# Secret pour signer la session (chaîne aléatoire longue)
SESSION_SECRET=une_chaine_aleatoire_tres_longue

# Clé API NowPayments (pour confirmer le webhook)
NOWPAYMENTS_API_KEY=ta_cle_nowpayments

# Nom d'utilisateur PayPal (affiché sur le panel)
PAYPAL_ME=ton_pseudo_paypal