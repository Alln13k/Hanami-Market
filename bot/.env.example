# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=ton_token_ici

# ID de l'application du bot
CLIENT_ID=ton_client_id_ici

# Optionnel : pour déployer les commandes seulement sur UN serveur en dev
# (laisse vide pour déployer en global / sur tous les serveurs)
GUILD_ID=

# URL de connexion MySQL fournie par ton hébergeur
# Format : mysql://utilisateur:motdepasse@hote:port/nom_base
DATABASE_URL=mysql://user:pass@host:3306/nom_de_la_base

# Clé API NowPayments pour les paiements Litecoin
# https://account.nowpayments.io/api-keys
NOWPAYMENTS_API_KEY=ta_cle_nowpayments

# Nom d'utilisateur PayPal (pour les liens paypal.me)
PAYPAL_ME=ton_pseudo_paypal

# URL de ton panel déployé sur Vercel (sans slash final)
# ex: https://mon-shop.vercel.app
PANEL_URL=

# Rôle autorisé à utiliser les commandes admin (ID du rôle "Admin" du serveur)
ADMIN_ROLE_ID=

# Couleur par défaut des embeds (hex sans le #)
DEFAULT_COLOR=5865F2