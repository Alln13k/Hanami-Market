generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Paramètres globaux (guild, salon admin, catégorie tickets, rôles, etc.)
model Setting {
  key   String @id
  value String
}

// Ticket d'achat / support (type: BUY, SUPPORT, OTHER)
model Ticket {
  id        String          @id @default(cuid())
  channelId String          @unique @db.VarChar(64)
  userId    String          @db.VarChar(64)
  userName  String          @default("")
  type      String          @default("SUPPORT")
  status    String          @default("OPEN") // OPEN | CLOSED
  createdAt DateTime        @default(now())
  closedAt  DateTime?
  messages  TicketMessage[]
}

// Message d'un ticket (stocké pour l'affichage et la réponse depuis le panel)
model TicketMessage {
  id         String   @id @default(cuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  authorId   String   @db.VarChar(64)
  authorName String   @default("")
  authorType String   @default("USER") // USER | STAFF | BOT
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

// Salon Discord synchronisé pour le choix d'envoi d'embeds
model GuildChannel {
  channelId String   @id @db.VarChar(64)
  name      String
  type      String   @default("TEXT") // TEXT | VOICE | CATEGORY
  position  Int      @default(0)
  parentId  String?  @db.VarChar(64)
  isText    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// File d'actions "panel -> bot" : le bot poll cette table et agit sur Discord
// type: CLOSE_TICKET | REPLY_TICKET | SEND_EMBED | CREATE_TICKET_BUTTON
model BotAction {
  id         String    @id @default(cuid())
  type       String
  payload    String    @db.Text // JSON
  status     String    @default("PENDING") // PENDING | DONE | FAILED
  error      String?   @db.Text
  createdAt  DateTime  @default(now())
  executedAt DateTime?
}