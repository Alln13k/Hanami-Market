generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Paramètres globaux (guild, salon admin, catégorie tickets, rôles, etc.)
model Setting {
  key   String @id
  value String
}

// Ticket d'achat / support (type: BUY, SUPPORT, OTHER)
model Ticket {
  id        String          @id @default(cuid())
  channelId String          @unique @db.VarChar(64)
  userId    String          @db.VarChar(64)
  userName  String          @default("")
  type      String          @default("SUPPORT")
  status         String          @default("OPEN") // OPEN | CLOSED
  createdAt      DateTime        @default(now())
  closedAt       DateTime?
  lastActivityAt DateTime        @default(now())
  messages       TicketMessage[]
}

// Message d'un ticket (stocké pour l'affichage et la réponse depuis le panel)
model TicketMessage {
  id         String   @id @default(cuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  authorId   String   @db.VarChar(64)
  authorName String   @default("")
  avatarUrl  String   @default("")
  authorType String   @default("USER") // USER | STAFF | BOT
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

// Membre du serveur synchronisé (nom d'affichage, avatar, statut booster)
model Member {
  userId    String   @id @db.VarChar(64)
  name      String   @default("")
  avatarUrl String   @default("")
  isBooster Boolean  @default(false)
  joinedAt  DateTime?
  updatedAt DateTime @updatedAt
}

// Journal de modération (ban / kick / unban)
model ModerationLog {
  id         String   @id @default(cuid())
  type       String // BAN | KICK | UNBAN
  targetId   String   @db.VarChar(64)
  targetName String   @default("")
  reason     String   @default("")
  createdAt  DateTime @default(now())
}

// Invitation du serveur (pour le tracking des arrivées)
model Invite {
  code      String   @id
  channelId String?  @db.VarChar(64)
  inviterId String?  @db.VarChar(64)
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Arrivée d'un membre via une invitation (+ départ éventuel)
model InviteJoin {
  id          String   @id @default(cuid())
  inviteCode  String   @default("")
  inviterId   String?  @db.VarChar(64)
  inviterName String   @default("")
  userId      String   @db.VarChar(64)
  userName    String   @default("")
  avatarUrl   String   @default("")
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
}

// Salon Discord synchronisé pour le choix d'envoi d'embeds
model GuildChannel {
  channelId String   @id @db.VarChar(64)
  name      String
  type      String   @default("TEXT") // TEXT | VOICE | CATEGORY
  position  Int      @default(0)
  parentId  String?  @db.VarChar(64)
  isText    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Rôle Discord synchronisé pour les permissions / commandes perso
model Role {
  roleId    String   @id @db.VarChar(64)
  name      String
  color     String   @default("")
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Commande personnalisée : quand un membre (avec le rôle requis) écrit le déclencheur,
// le bot répond par un texte ou un embed
model CustomCommand {
  id           String   @id @default(cuid())
  trigger      String   @unique
  roleId       String?  @db.VarChar(64)
  responseType String   @default("TEXT") // TEXT | EMBED
  text         String   @default("")
  title        String   @default("")
  description  String   @default("")
  color        String   @default("f49ecd")
  imageUrl     String   @default("")
  footer       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Produit affiché dans l'embed public (sans système de paiement)
model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  color       String   @default("f49ecd")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Transcription archivée à la fermeture d'un ticket (le ticket est ensuite supprimé)
model TicketTranscript {
  id        String   @id @default(cuid())
  channelId String   @db.VarChar(64)
  userId    String   @db.VarChar(64)
  userName  String   @default("")
  type      String   @default("SUPPORT")
  content   String   @db.Text
  openedAt  DateTime
  closedAt  DateTime
  createdAt DateTime @default(now())
}

// File d'actions "panel -> bot" : le bot poll cette table et agit sur Discord
// type: CLOSE_TICKET | REPLY_TICKET | SEND_EMBED | CREATE_TICKET_BUTTON | UPDATE_PRODUCTS_EMBED | UPDATE_LEADERBOARD_EMBED | ADD_SPEND | SYNC_BOOSTERS | SYNC_ROLES | SEND_PROOF | SEND_VOUCH_TUTORIAL | DELETE_VOUCH | SEND_WELCOME_TEST | BAN_USER | KICK_USER | UNBAN_USER | SYNC_INVITES
model BotAction {
  id         String    @id @default(cuid())
  type       String
  payload    String    @db.Text // JSON
  status     String    @default("PENDING") // PENDING | DONE | FAILED
  error      String?   @db.Text
  createdAt  DateTime  @default(now())
  executedAt DateTime?
}

// Total dépensé par membre (leaderboard public)
model LeaderboardEntry {
  userId     String   @id @db.VarChar(64)
  username   String   @default("")
  totalSpend Decimal  @db.Decimal(10, 2)
  roleId     String?  @db.VarChar(64) // rôle récompense atteint
  updatedAt  DateTime @updatedAt
}

// Palier de récompense : au-delà d'un total dépensé, le membre gagne un rôle
model SpendRole {
  id        String   @id @default(cuid())
  name      String
  roleId    String   @db.VarChar(64)
  threshold Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Preuve envoyée par le bot dans le salon proof (image + numéro automatique)
model Proof {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  image     Bytes    @db.LongBlob
  mimeType  String   @default("image/png")
  createdAt DateTime @default(now())
}

// Vouch postée par un membre (+vouch @membre prix produit x1)
model Vouch {
  id           String   @id @default(cuid())
  messageId    String   @db.VarChar(64)
  channelId    String   @db.VarChar(64)
  userId       String   @db.VarChar(64)
  userName     String   @default("")
  targetUserId String   @db.VarChar(64)
  targetName   String   @default("")
  price        Decimal  @db.Decimal(10, 2)
  product      String   @default("")
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())
}